{
  "manifest_version": 3,
  "name": "ToocaaLaser Connect",
  "version": "1.1",
  "description": "Lets the ToocaaLaser web app talk to a TOOCAA NOVA on your local network (HTTP + WebSocket on port 8002). Local IP addresses only.",
  "key": "",
  "host_permissions": [
    "http://*/*",
    "ws://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://chuck3cz.github.io/ToocaaLaser/*",
      "http://localhost:8765/*",
      "http://127.0.0.1:8765/*"
    ]
  },
  "icons": {
    "128": "icon128.png"
  }
}
